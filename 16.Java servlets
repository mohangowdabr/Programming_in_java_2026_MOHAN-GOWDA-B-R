ShoppingServlet.java


import java.io.*;
import jakarta.servlet.*;
import jakarta.servlet.http.*;

public class ShoppingServlet extends HttpServlet {

    public void init() throws ServletException {
        System.out.println("Servlet Initialized");
    }

    public void service(HttpServletRequest request,
                        HttpServletResponse response)
                        throws ServletException, IOException {

        super.service(request, response);
    }

    public void doGet(HttpServletRequest request,
                      HttpServletResponse response)
                      throws ServletException, IOException {

        response.setContentType("text/html");
        PrintWriter out = response.getWriter();

        String product = request.getParameter("product");

        out.println("<html><body>");
        out.println("<h2>Product Search Result</h2>");

        if (product == null || product.trim().isEmpty()) {
            out.println("Please enter a product name.");
        } else if (product.equalsIgnoreCase("Laptop")) {
            out.println("Product: Laptop<br>");
            out.println("Price: Rs. 50000");
        } else if (product.equalsIgnoreCase("Mobile")) {
            out.println("Product: Mobile<br>");
            out.println("Price: Rs. 20000");
        } else if (product.equalsIgnoreCase("Headphones")) {
            out.println("Product: Headphones<br>");
            out.println("Price: Rs. 1500");
        } else {
            out.println("Product not found.");
        }

        out.println("<br><br><a href='index.html'>Go Back</a>");
        out.println("</body></html>");
    }

    public void doPost(HttpServletRequest request,
                       HttpServletResponse response)
                       throws ServletException, IOException {

        response.setContentType("text/html");
        PrintWriter out = response.getWriter();

        String action = request.getParameter("action");

        out.println("<html><body>");

        if ("login".equals(action)) {

            String username = request.getParameter("username");
            String password = request.getParameter("password");

            if ("admin".equals(username) &&
                "1234".equals(password)) {

                out.println("<h2>Login Successful.</h2>");
            } else {
                out.println("<h2>Invalid Username or Password.</h2>");
            }

        } else if ("order".equals(action)) {

            String customer = request.getParameter("customer");
            String product = request.getParameter("orderProduct");
            String quantityText = request.getParameter("quantity");

            try {
                int quantity = Integer.parseInt(quantityText);

                if (customer == null || customer.trim().isEmpty()
                    || product == null || product.trim().isEmpty()
                    || quantity <= 0) {

                    out.println("Invalid order details.");

                } else if (!product.equalsIgnoreCase("Laptop")
                        && !product.equalsIgnoreCase("Mobile")
                        && !product.equalsIgnoreCase("Headphones")) {

                    out.println("Product not found.");

                } else {
                    out.println("<h2>Order placed successfully.</h2>");
                    out.println("Customer: " + customer + "<br>");
                    out.println("Product: " + product + "<br>");
                    out.println("Quantity: " + quantity);
                }

            } catch (NumberFormatException e) {
                out.println("Please enter a valid quantity.");
            }

        } else {
            out.println("Invalid request.");
        }

        out.println("<br><br><a href='index.html'>Go Back</a>");
        out.println("</body></html>");
    }

    public void destroy() {
        System.out.println("Servlet Destroyed");
    }
}

