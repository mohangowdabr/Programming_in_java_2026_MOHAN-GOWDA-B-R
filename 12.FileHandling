
import java.io.*;
import java.util.Scanner;

class LibraryTransaction {
    String id, name, student, issueDate, returnDate;

    LibraryTransaction(String id, String name, String student,
                       String issueDate, String returnDate) {
        this.id = id;
        this.name = name;
        this.student = student;
        this.issueDate = issueDate;
        this.returnDate = returnDate;
    }

    public String toString() {
        return "Book ID: " + id
                + "\nBook Name: " + name
                + "\nStudent Name: " + student
                + "\nIssue Date: " + issueDate
                + "\nReturn Date: " + returnDate
                + "\n--------------------\n";
    }
}

public class FileHandling {
    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);
        String fileName = "transactions.txt";
        int choice = 0;

        while (choice != 3) {
            System.out.println("\n1. Record Book Transaction");
            System.out.println("2. View Transaction Records");
            System.out.println("3. Exit");
            System.out.print("Enter your choice: ");

            try {
                choice = Integer.parseInt(sc.nextLine());
            } catch (NumberFormatException e) {
                System.out.println("Invalid choice. Please select a valid option.");
                continue;
            }

            if (choice == 1) {
                System.out.print("Enter Book ID: ");
                String id = sc.nextLine();

                System.out.print("Enter Book Name: ");
                String name = sc.nextLine();

                System.out.print("Enter Student/User Name: ");
                String student = sc.nextLine();

                System.out.print("Enter Issue Date: ");
                String issueDate = sc.nextLine();

                System.out.print("Enter Return Date: ");
                String returnDate = sc.nextLine();

                LibraryTransaction t = new LibraryTransaction(
                        id, name, student, issueDate, returnDate);

                try (FileWriter fw = new FileWriter(fileName, true)) {
                    fw.write(t.toString());
                    System.out.println("Transaction recorded successfully.");
                } catch (IOException e) {
                    System.out.println("Unable to write to the file.");
                }
            }

            else if (choice == 2) {
                File file = new File(fileName);

                if (!file.exists()) {
                    System.out.println("No transaction records found.");
                } else {
                    try (FileReader fr = new FileReader(file)) {
                        int ch;

                        while ((ch = fr.read()) != -1) {
                            System.out.print((char) ch);
                        }
                    } catch (IOException e) {
                        System.out.println("Unable to read the file.");
                    }
                }
            }

            else if (choice == 3) {
                System.out.println("Exiting Library Management System.");
            }

            else {
                System.out.println("Invalid choice. Please select a valid option.");
            }
        }

        sc.close();
    }
}

