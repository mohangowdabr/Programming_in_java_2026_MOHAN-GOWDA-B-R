import java.util.Scanner;

// Super Class
class Payment {

    // Method Overloading - 1
    void makePayment(double amount) {
        if (amount < 0) {
            System.out.println("Invalid payment amount.");
        } else if (amount == 0) {
            System.out.println("Payment amount cannot be zero.");
        } else {
            System.out.println("Processing payment of ₹" + amount);
        }
    }

    // Method Overloading - 2
    void makePayment(double amount, String transactionId) {
        if (amount < 0) {
            System.out.println("Invalid payment amount.");
        } else if (amount == 0) {
            System.out.println("Payment amount cannot be zero.");
        } else if (transactionId == null || transactionId.isEmpty()) {
            System.out.println("Invalid Transaction ID.");
        } else if (!transactionId.startsWith("TXN")) {
            System.out.println("Invalid Transaction ID format.");
        } else {
            System.out.println("Processing payment of ₹" + amount
                    + " with Transaction ID: " + transactionId);
        }
    }
}

// Sub Class 1
class CreditCardPayment extends Payment {

    @Override
    void makePayment(double amount) {
        if (amount < 0) {
            System.out.println("Invalid payment amount.");
        } else if (amount == 0) {
            System.out.println("Payment amount cannot be zero.");
        } else {
            System.out.println("₹" + amount + " paid using Credit Card.");
        }
    }
}

// Sub Class 2
class UPIPayment extends Payment {

    @Override
    void makePayment(double amount) {
        if (amount < 0) {
            System.out.println("Invalid payment amount.");
        } else if (amount == 0) {
            System.out.println("Payment amount cannot be zero.");
        } else {
            System.out.println("₹" + amount + " paid using UPI.");
        }
    }
}

// Sub Class 3
class NetBankingPayment extends Payment {

    @Override
    void makePayment(double amount) {
        if (amount < 0) {
            System.out.println("Invalid payment amount.");
        } else if (amount == 0) {
            System.out.println("Payment amount cannot be zero.");
        } else {
            System.out.println("₹" + amount + " paid using Net Banking.");
        }
    }
}

// Main Class
public class PaymentPolymorphismDemo {

    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        // Input
        System.out.print("Enter Credit Card payment amount: ");
        double ccAmount = sc.nextDouble();

        System.out.print("Enter UPI payment amount: ");
        double upiAmount = sc.nextDouble();

        System.out.print("Enter Net Banking payment amount: ");
        double nbAmount = sc.nextDouble();

        System.out.print("Enter amount for overloaded payment: ");
        double amount = sc.nextDouble();
        sc.nextLine();

        System.out.print("Enter Transaction ID: ");
        String transactionId = sc.nextLine();

        // Parent class reference
        Payment payment;

        // Runtime Polymorphism
        System.out.println("\n--- Runtime Polymorphism ---");

        payment = new CreditCardPayment();
        payment.makePayment(ccAmount);

        payment = new UPIPayment();
        payment.makePayment(upiAmount);

        payment = new NetBankingPayment();
        payment.makePayment(nbAmount);

        // Compile-Time Polymorphism
        System.out.println("\n--- Compile-Time Polymorphism ---");

        Payment basicPayment = new Payment();
        basicPayment.makePayment(amount, transactionId);

        // Null object test
        System.out.println("\n--- Null Payment Object Test ---");

        payment = null;

        if (payment == null) {
            System.out.println("Payment object is null.");
        } else {
            payment.makePayment(1000);
        }

        sc.close();
    }
}
