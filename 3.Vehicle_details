import java.util.Scanner;

// Abstract class
abstract class Vehicle {
    String vehicleNumber;
    String brand;

    Vehicle(String vehicleNumber, String brand) {
        this.vehicleNumber = vehicleNumber;
        this.brand = brand;
    }

    // Abstract method - no body, must be implemented by subclasses
    abstract void startEngine();

    // Final method - cannot be overridden by any subclass
    final void showVehicleIdentity() {
        System.out.println("Vehicle Number : " + vehicleNumber);
        System.out.println("Brand          : " + brand);
    }
}

// Sub class 1
class Car extends Vehicle {
    Car(String vehicleNumber, String brand) {
        super(vehicleNumber, brand);
    }

    void startEngine() {
        System.out.println("Car engine started with key ignition.");
    }
}

// Sub class 2
class Bike extends Vehicle {
    Bike(String vehicleNumber, String brand) {
        super(vehicleNumber, brand);
    }

    void startEngine() {
        System.out.println("Bike engine started with self-start button.");
    }
}

// Main class
public class VehicleAbstractDemo {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        // ---- Car ----
        System.out.println("Enter Car details:");
        System.out.print("Vehicle Number: ");
        String carNumber = sc.nextLine();
        System.out.print("Brand: ");
        String carBrand = sc.nextLine();

        Car car = new Car(carNumber, carBrand);
        System.out.println("\n--- Car Details ---");
        car.showVehicleIdentity();
        car.startEngine();

        // ---- Bike ----
        System.out.println("\nEnter Bike details:");
        System.out.print("Vehicle Number: ");
        String bikeNumber = sc.nextLine();
        System.out.print("Brand: ");
        String bikeBrand = sc.nextLine();

        Bike bike = new Bike(bikeNumber, bikeBrand);
        System.out.println("\n--- Bike Details ---");
        bike.showVehicleIdentity();
        bike.startEngine();

        sc.close();
    }
}
